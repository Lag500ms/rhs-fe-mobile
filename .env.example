# API base URL (bắt buộc kết thúc bằng /api). Trùng web đã deploy để OTP email gửi được.
# API local (không gửi được mail OTP trên Render): http://10.0.2.2:5112/api
EXPO_PUBLIC_API_BASE_URL=https://rhs-backend-api.onrender.com/api

# Mapbox public token (pk.*) — hạn chế URL/domain trên Mapbox dashboard
# Không đặt secret key (sk.*) vào biến EXPO_PUBLIC_*
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
